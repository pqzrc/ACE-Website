# ============================================
# Configuration pour le script d'envoi d'emails
# ============================================

# SMTP Configuration
# Pour local (MailHog): localhost:1025
# Pour prod: votre serveur SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@yourdomain.com

# Database Configuration
# Pour local: localhost:5433
# Pour prod: postgres:5432 (dans Docker)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=acedb
DB_USER=aceuser
DB_PASSWORD=CHANGEME_DB_PASSWORD

# Frontend URL
FRONTEND_URL=http://localhost:3000
