# ============================================
# ACE Website - Production Environment
# ============================================
# IMPORTANT: Remplacez les valeurs CHANGEME avant le déploiement

# Environment Mode
NODE_ENV=production

# Frontend API URL (utilisé par Next.js côté client)
NEXT_PUBLIC_API_URL=https://api.vizyondijital.fr/api

# CTFd URL (utilisé pour le SSO)
NEXT_PUBLIC_CTFD_URL=https://ctfd.vizyondijital.fr

# Database
DATABASE_URL=postgresql://aceuser:CHANGEME_DB_PASSWORD@postgres:5432/acedb
POSTGRES_DB=acedb
POSTGRES_USER=aceuser
POSTGRES_PASSWORD=CHANGEME_DB_PASSWORD

# Redis
REDIS_URL=redis://redis:6379

# JWT Authentication (DOIT être identique à CTFd pour SSO)
JWT_SECRET=CHANGEME_GENERATE_STRONG_SECRET_64_CHARS
JWT_EXPIRES_IN=7d

# Email - Production SMTP
# Option 1: Gmail (décommentez et configurez)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=votre-email@gmail.com
# SMTP_PASS=votre-app-password
# SMTP_FROM=ACE 2025 <noreply@vizyondijital.fr>

# Option 2: MailHog (développement local)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=ACE 2025 <noreply@vizyondijital.fr>

# Frontend URL (Production)
FRONTEND_URL=https://ace.vizyondijital.fr

# Admin Configuration
ADMIN_EMAIL=admin@vizyondijital.fr
ADMIN_PASSWORD=CHANGEME_ADMIN_PASSWORD

# CTFd Webhook Configuration
CTFD_WEBHOOK_URL=http://ctfd:8000/api/registration-sync/webhook
WEBHOOK_SECRET=CHANGEME_WEBHOOK_SECRET_SHARED_WITH_CTFD

# hCaptcha Configuration (Production - obtenez vos clés sur hcaptcha.com)
# Pour le développement, utilisez les clés de test:
HCAPTCHA_SECRET=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_HCAPTCHA_SITEKEY=10000000-ffff-ffff-ffff-000000000001

# ============================================
# Comment générer des secrets sécurisés :
# ============================================
# JWT_SECRET (64 caractères) :
#   openssl rand -hex 32
#
# WEBHOOK_SECRET (32 caractères) :
#   openssl rand -hex 16
#
# Mot de passe fort :
#   openssl rand -base64 24
#