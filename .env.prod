# Backend Configuration

# DOCKER_ENV=true (automatiquement défini dans docker-compose.yml)

# Environment Mode (development ou production)
NODE_ENV=production

# Frontend API URL (utilisé par Next.js côté client)
NEXT_PUBLIC_API_URL=https://api.vizyondijital.fr/api

# CTFd URL (utilisé pour le SSO)
NEXT_PUBLIC_CTFD_URL=https://ctfd.vizyondijital.fr

# Database
DATABASE_URL=postgresql://aceuser:acepass@postgres:5432/acedb

# Redis
REDIS_URL=redis://redis:6379

# JWT Authentication (doit être identique à CTFd pour SSO)
JWT_SECRET=ace2025_jwt_secret_shared_between_ctfd_and_website
JWT_EXPIRES_IN=7d

# Email - MailHog (local, rapide pour dev - recommandé)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ACE 2025 <noreply@ace.com>

# Email - Mailtrap (externe, pour tester rendu emails)
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=22525
# SMTP_USER=your_mailtrap_user
# SMTP_PASS=your_mailtrap_password
# SMTP_FROM=ACE 2025 <noreply@ace.com>

# Email - Production (Gmail, SendGrid, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=ACE Escape Game <noreply@ace-escapegame.com>

# Frontend URL
FRONTEND_URL=https://ace.vizyondijital.fr

# Admin Configuration
ADMIN_EMAIL=admin@ace-escapegame.com
ADMIN_PASSWORD=Admin123!ChangeMoi
# Hash bcrypt fixe du mot de passe admin (généré avec: node -e "require('bcryptjs').hash('YourPassword', 10).then(console.log)")
ADMIN_HASH=

# CTFd Webhook Configuration
CTFD_WEBHOOK_URL=http://ace-ctf-platform-ctfd-1:8000/api/registration-sync/webhook
WEBHOOK_SECRET=ace2025_webhook_secret_shared

# hCaptcha Configuration (Protection anti-bot)
# Clés de TEST (passent toujours la validation, pour développement uniquement) :
HCAPTCHA_SECRET=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_HCAPTCHA_SITEKEY=10000000-ffff-ffff-ffff-000000000001
