# ============================================
# ACE Website - Environment Configuration
# ============================================
#
# IMPORTANT: Sur le VPS, faites:
#   cp .env.example .env
#   nano .env
#   # Remplacez tous les CHANGEME par vos vraies valeurs
#
# ============================================

# Environment Mode (development ou production)
NODE_ENV=production

# Frontend URLs (utilisé par Next.js côté client)
# Production: https://api.vizyondijital.fr/api
# Dev: http://localhost:5000/api
NEXT_PUBLIC_API_URL=https://api.vizyondijital.fr/api
NEXT_PUBLIC_CTFD_URL=https://ctfd.vizyondijital.fr

# Database Configuration
DATABASE_URL=postgresql://aceuser:CHANGEME_STRONG_PASSWORD@postgres:5432/acedb
POSTGRES_DB=acedb
POSTGRES_USER=aceuser
POSTGRES_PASSWORD=CHANGEME_STRONG_PASSWORD

# Redis Configuration
REDIS_URL=redis://redis:6379

# JWT Authentication (IMPORTANT: doit être identique à CTFd pour SSO)
JWT_SECRET=CHANGEME_LONG_RANDOM_SECRET_SHARED_WITH_CTFD
JWT_EXPIRES_IN=7d

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=ACE Escape Game <noreply@ace-escapegame.com>

# Frontend URL interne (communication Docker entre services)
FRONTEND_URL=http://frontend:3000

# Frontend URL publique (pour les liens dans les emails)
FRONTEND_PUBLIC_URL=https://ace.vizyondijital.fr

# Admin Configuration
ADMIN_EMAIL=admin@ace-escapegame.com
ADMIN_PASSWORD=CHANGEME_VERY_STRONG_ADMIN_PASSWORD
ADMIN_HASH=

# CTFd Integration (API)
# Utiliser le nom du service Docker CTFd
CTFD_API_URL=http://ctfd:8000
CTFD_API_TOKEN=CHANGEME_GET_FROM_CTFD_ADMIN_PANEL
CTFD_URL=http://ctfd:8000

# CTFd Webhook Configuration
CTFD_WEBHOOK_URL=http://ctfd:8000/api/registration-sync/webhook
WEBHOOK_SECRET=CHANGEME_WEBHOOK_SECRET_SHARED_WITH_CTFD

# hCaptcha Configuration
# Production: vos vraies clés hCaptcha
HCAPTCHA_SECRET=your-real-hcaptcha-secret-key
NEXT_PUBLIC_HCAPTCHA_SITEKEY=your-real-hcaptcha-site-key

# Event Configuration
EVENT_START_TIME=2025-02-01T09:00:00Z
EVENT_END_TIME=2025-02-01T17:00:00Z

# Logs Configuration
DB_LOGGING=false

# Server Port
PORT=5000
