# ============================================
# ACE Website - Environment Configuration Template
# ============================================
#
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env.local (for local dev)
# 2. Fill in ALL values marked with CHANGEME
# 3. For production, use secure secrets management (not .env files)
#
# ============================================

# Environment Mode
NODE_ENV=development

# Frontend URLs (Client-side)
# Local: http://localhost:5000/api | Prod: https://api.yourdomain.com/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# Local: http://localhost:8000 | Prod: https://ctfd.yourdomain.com
NEXT_PUBLIC_CTFD_URL=http://localhost:8000

# Database Configuration
# Generate password: openssl rand -hex 24
DATABASE_URL=postgresql://aceuser:CHANGEME_DB_PASSWORD@postgres:5432/acedb
POSTGRES_DB=acedb
POSTGRES_USER=aceuser
POSTGRES_PASSWORD=CHANGEME_DB_PASSWORD

# Redis Configuration
REDIS_URL=redis://redis:6379

# JWT Authentication
# Generate: openssl rand -hex 32
# IMPORTANT: Must match CTFd JWT_SECRET for SSO
JWT_SECRET=CHANGEME_JWT_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=7d

# Email Configuration
# For local dev, use MailHog (mailhog:1025)
# For production, configure your SMTP server
MAIL_SERVER=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAILFROM_ADDR=noreply@yourdomain.com

# Frontend URLs
FRONTEND_URL=http://frontend:3000
FRONTEND_PUBLIC_URL=http://localhost:3000

# Admin Configuration
# Generate password: openssl rand -base64 24
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGEME_ADMIN_PASSWORD
ADMIN_HASH=

# CTFd Integration
CTFD_API_URL=http://ctfd:8000
# Get token from CTFd Admin Panel > Settings > Access Tokens
CTFD_API_TOKEN=CHANGEME_GET_FROM_CTFD_ADMIN_PANEL
CTFD_URL=http://ctfd:8000

# CTFd Webhook Configuration
# Generate: openssl rand -hex 16
# IMPORTANT: Must match CTFd WEBHOOK_SECRET
CTFD_WEBHOOK_URL=http://ctfd:8000/api/registration-sync/webhook
WEBHOOK_SECRET=CHANGEME_WEBHOOK_SECRET

# hCaptcha Configuration
# Get keys from https://dashboard.hcaptcha.com
# Test keys (always pass): secret=0x0000000000000000000000000000000000000000, sitekey=10000000-ffff-ffff-ffff-000000000001
HCAPTCHA_SECRET=CHANGEME_HCAPTCHA_SECRET
NEXT_PUBLIC_HCAPTCHA_SITEKEY=CHANGEME_HCAPTCHA_SITEKEY

# Event Configuration
EVENT_START_TIME=2025-12-11T09:00:00Z
EVENT_END_TIME=2025-12-11T18:00:00Z

# Logs Configuration
DB_LOGGING=false

# Server Port
PORT=5000
