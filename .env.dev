# Backend Configuration - ENVIRONNEMENT DE DÉVELOPPEMENT LOCAL

# Database (utiliser le nom du service Docker)
DATABASE_URL=postgresql://aceuser:acepass@postgres:5432/acedb

# Redis (utiliser le nom du service Docker)
REDIS_URL=redis://redis:6379

# JWT Authentication (doit être identique à CTFd pour SSO)
JWT_SECRET=dev_jwt_secret_changez_moi
JWT_EXPIRES_IN=7d

# Email - MailHog (utiliser le nom du service Docker)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ACE 2025 <noreply@ace.local>

# Frontend URL interne (communication Docker entre services)
FRONTEND_URL=http://frontend:3000

# Frontend URL publique (pour les liens dans les emails)
FRONTEND_PUBLIC_URL=http://localhost:3000

# Admin Configuration
ADMIN_EMAIL=admin@ace.local
ADMIN_PASSWORD=Admin123!
ADMIN_HASH=

# CTFd Integration (API)
CTFD_API_URL=http://ace-ctf-dev-ctfd-1:8000
CTFD_API_TOKEN=ctfd_ad91030aec60cc215d524c8c70b0cd80ef3081e8f8841baccc27d77d7a0eb458
CTFD_URL=http://ace-ctf-dev-ctfd-1:8000

# CTFd Webhook Configuration (utiliser le nom du service Docker CTFd)
CTFD_WEBHOOK_URL=http://ace-ctf-dev-ctfd-1:8000/api/registration-sync/webhook
WEBHOOK_SECRET=dev_webhook_secret_shared

# hCaptcha Configuration (Clés de TEST)
HCAPTCHA_SECRET=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_HCAPTCHA_SITEKEY=10000000-ffff-ffff-ffff-000000000001

# CTFd URL publique (pour le navigateur)
NEXT_PUBLIC_CTFD_URL=http://localhost:8000

# API URL publique (pour le navigateur)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Event Configuration
# 11 décembre 2025 à 18h30 EST (23h30 UTC) jusqu'à 23h00 EST (04h00 UTC le 12)
EVENT_START_TIME=2025-12-11T23:30:00Z
EVENT_END_TIME=2025-12-12T04:00:00Z

# Environnement
NODE_ENV=development
PORT=5000

# Logs - Désactiver les logs SQL en dev
DB_LOGGING=false
