# Development Environment Configuration
# Mode développement local

# Environment Mode
NODE_ENV=development

# Frontend API URL (utilisé par Next.js côté client)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# CTFd URL (pour le SSO - local)
NEXT_PUBLIC_CTFD_URL=http://localhost:8000

# Database (PostgreSQL local via Docker)
DATABASE_URL=postgresql://aceuser:acepass_dev@postgres:5432/acedb_dev

# Redis (local via Docker)
REDIS_URL=redis://redis:6379

# JWT Authentication (même secret que CTFd pour SSO)
JWT_SECRET=ace2025_jwt_secret_dev_local
JWT_EXPIRES_IN=7d

# Email - MailHog (pour dev local - pas d'envoi réel)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ACE Dev <noreply@ace-dev.local>

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Admin Configuration (dev)
ADMIN_EMAIL=admin@ace-dev.local
ADMIN_PASSWORD=Admin123Dev!
ADMIN_HASH=

# CTFd Webhook Configuration (local)
CTFD_WEBHOOK_URL=http://localhost:8000/api/registration-sync/webhook
WEBHOOK_SECRET=ace2025_webhook_secret_dev

# hCaptcha Configuration - CLÉS DE TEST (passent toujours)
HCAPTCHA_SECRET=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_HCAPTCHA_SITEKEY=10000000-ffff-ffff-ffff-000000000001

# CORS (automatiquement configuré pour localhost en mode development)
# Pas besoin de variable, géré dans server.ts

# Database Credentials (utilisées par docker-compose)
POSTGRES_DB=acedb_dev
POSTGRES_USER=aceuser
POSTGRES_PASSWORD=acepass_dev
